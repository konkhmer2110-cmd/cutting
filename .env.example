# Production / hosted database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_POOL_MAX=10
PORT=4000
NODE_ENV=production

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=43200
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-deploy
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_NAME=System Administrator

# Optional only if frontend and API are hosted on different domains
# CLIENT_ORIGIN=https://your-frontend.example.com
# VITE_API_URL=https://your-api.example.com/api
